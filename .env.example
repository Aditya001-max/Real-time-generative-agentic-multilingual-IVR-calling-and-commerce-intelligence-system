# =====================================================================
# AI Call Automation Microservice — .env template
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# =====================================================================

# ---------- Telephony: Ozonetel KooKoo ----------
OZONETEL_API_KEY=
OZONETEL_USERNAME=
OZONETEL_DID=
OZONETEL_API_BASE=https://in1-cpaas.ozonetel.com
OZONETEL_OUTBOUND_PATH=/outbound/outbound.php
# Set if using a CloudAgent IVR Flow (routes calls via app_id+extra_data)
OZONETEL_APP_ID=

# CloudAgent Campaign (required for CloudAgent IVR Flow triggering)
OZONETEL_CAMPAIGN_NAME=
OZONETEL_CLOUDAGENT_API_BASE=https://api.cloudagent.ozonetel.com

# Emit Google Wavenet voice attribute. Requires Ozonetel Pro. Default False.
KOOKOO_USE_WAVENET=false

# ---------- Public URLs ----------
BASE_URL=http://localhost:8000
# Where pre-recorded audio is served (empty = derive from BASE_URL)
AUDIO_PUBLIC_BASE=

# ---------- Database ----------
DATABASE_URL=sqlite:///./db.sqlite3

# ---------- Supabase (optional) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=imports

# ---------- Redis / Celery ----------
# For docker compose: redis://host.docker.internal:6379/0
REDIS_URL=redis://localhost:6379/0

# ---------- Working hours ----------
WORKING_HOURS_START=9
WORKING_HOURS_END=18
TIMEZONE=Asia/Kolkata

# Dev override: force language picker every call (leave false in prod)
FORCE_LANGUAGE_PICKER=false

# Ops hunt-group for live transfers (E.164 or SIP URI). Empty = disabled.
TEAM_HUNT_GROUP=

# ---------- Excel export (daily Celery beat 22:00 IST) ----------
EXCEL_EXPORT_DIR=./exports
EXCEL_EXPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Divine Hindu IVR <ivr@divinehindu.in>

# ---------- Action Engine integrations ----------
OMS_API_URL=
OMS_API_KEY=
NOTIFICATION_API_URL=
NOTIFICATION_API_KEY=

# =====================================================================
# AI VOICE — Provider chain
# =====================================================================
# Master switch for self-hosted TTS (Coqui / ElevenLabs). False = KooKoo Google TTS.
USE_AI_VOICE=false
# Priority order: coqui | coqui,elevenlabs | elevenlabs
TTS_PROVIDERS=coqui,elevenlabs
AUDIO_CACHE_DIR=./audio_cache

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true

# --- Coqui XTTS-v2 ---
USE_COQUI_TTS=false
COQUI_LANGUAGE=en
COQUI_SPEAKER=Ana Florence
# Optional: path to 6-second WAV for voice cloning
COQUI_SPEAKER_WAV=

# Optional per-language voice overrides for edge-tts backend (example):
# EDGE_VOICE_EN=en-US-JennyNeural
# EDGE_VOICE_HI=hi-IN-SwaraNeural

# =====================================================================
# TICKETING — Provider chain
# =====================================================================
# Priority: chatwoot | chatwoot,http | http | none
TICKET_PROVIDERS=chatwoot,http

# --- Chatwoot (open source) ---
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- Generic HTTP ticket system ---
TICKET_API_URL=
TICKET_API_KEY=
#---adding meta API for wattsapp---
META_API_URL=
META_API_KEY=
META_API_SECRET=
META_API_TOKEN=
META_API_TOKEN_SECRET=
META_API_TOKEN_SECRET=


