# =====================================================================
# Divine Hindu AI Call Automation — environment configuration
# Copy to .env and fill in real values. Anything left blank uses defaults.
# NEVER commit .env to git. NEVER paste real secrets into .env.example.
# =====================================================================

# ----- Telephony: Ozonetel KooKoo (CloudAgent Pro) -----
OZONETEL_API_KEY=
OZONETEL_USERNAME=
OZONETEL_DID=
# CloudAgent IVR Flow ID (only set if you use OZONETEL_APP_ID-based routing).
OZONETEL_APP_ID=
# CloudAgent Campaign name (only set when triggering via AddCampaignData).
OZONETEL_CAMPAIGN_NAME=
# Override the API base only if Ozonetel support has given you a different region.
# OZONETEL_API_BASE=https://in1-cpaas.ozonetel.com
# OZONETEL_OUTBOUND_PATH=/outbound/outbound.php
# OZONETEL_CLOUDAGENT_API_BASE=https://api.cloudagent.ozonetel.com

# Use Google Wavenet voices (premium, natural-sounding) via KooKoo
# <playtext type="ggl" voice="...">. Confirm with Ozonetel that your
# account honours the voice attribute BEFORE flipping to true.
KOOKOO_USE_WAVENET=false

# ----- Public URL -----
# Where Ozonetel hits your webhooks. ngrok in dev, your Render URL in prod.
BASE_URL=http://localhost:8000

# ----- Database -----
# SQLite for local dev. Postgres / Supabase for prod.
# Supabase (session pooler, port 5432):
#   postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./db.sqlite3

# ----- Supabase (optional — only needed if uploading files to Storage) -----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=imports

# ----- Redis / Celery (retry engine) -----
REDIS_URL=redis://localhost:6379/0

# ----- Working hours (used by help_router for live transfer vs callback) -----
WORKING_HOURS_START=9
WORKING_HOURS_END=18
TIMEZONE=Asia/Kolkata

# Force the language picker to play on every call (dev only).
# In production, returning customers should skip the picker.
FORCE_LANGUAGE_PICKER=false

# Agent hunt-group number for live transfers (E.164 or SIP URI).
# Leave blank to disable transfers and queue every help request as a callback.
TEAM_HUNT_GROUP=

# ----- Ticketing: Chatwoot (preferred) + generic HTTP fallback -----
# Provider priority: chatwoot,http | chatwoot | http | none
TICKET_PROVIDERS=chatwoot
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
# Generic HTTP ticket system (Zendesk/Freshdesk-style) — fallback only.
TICKET_API_URL=
TICKET_API_KEY=

# ----- Self-hosted AI voice (OPTIONAL — leave false to use Ozonetel Google TTS) -----
USE_AI_VOICE=false
TTS_PROVIDERS=coqui,elevenlabs
AUDIO_CACHE_DIR=./audio_cache
# Coqui XTTS-v2 (open-source, local, free):
USE_COQUI_TTS=false
COQUI_LANGUAGE=en
COQUI_SPEAKER=Ana Florence
COQUI_SPEAKER_WAV=
# ElevenLabs (paid):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true

# ----- Excel export of call logs (Celery beat, daily 22:00 IST) -----
EXCEL_EXPORT_DIR=./exports
EXCEL_EXPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Divine Hindu IVR <ivr@divinehindu.in>

# ----- Action Engine integrations (only set if you have these systems) -----
OMS_API_URL=
OMS_API_KEY=
NOTIFICATION_API_URL=
NOTIFICATION_API_KEY=
